{
  "id": "remotehand.target-monitor",
  "name": "RemoteHand Target Monitor",
  "version": "0.7.1",
  "apiVersion": 1,
  "author": "RemoteHand",
  "description": "Target, service, and endpoint monitoring for RemoteHand.",
  "runtime": {
    "kind": "executable",
    "entrypoints": {
      "windows-x86_64": "bin/windows-x86_64/remotehand-target-monitor.exe",
      "linux-x86_64": "bin/linux-x86_64/remotehand-target-monitor",
      "linux-aarch64": "bin/linux-aarch64/remotehand-target-monitor"
    }
  },
  "permissions": [
    "network.connect",
    "network.inspect",
    "clipboard.write",
    "files.save",
    "storage.plugin",
    "tray.contribute",
    "notifications.show"
  ],
  "contributes": {
    "panels": [
      {
        "id": "target-monitor",
        "title": "Target Monitor",
        "entry": "ui/index.html"
      }
    ],
    "commands": [
      {
        "id": "open",
        "title": "Open Target Monitor"
      }
    ]
  }
}
